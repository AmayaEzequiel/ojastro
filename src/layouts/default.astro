---
import ModelCard from "../components/ModelCard.astro";
import { misModelos } from "../data/modelos.js";


// Filtramos: solo pasan los modelos que tienen ambos campos con texto
const modelosDisponibles = misModelos.filter(
  (modelo) =>
    modelo.urlPage &&
    modelo.urlPage.trim() !== "" &&
    modelo.urlSpecs &&
    modelo.urlSpecs.trim() !== "",
);

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  canonical?: string;
  keywords?: string;
  headScripts?: Array<{ src?: string; content?: string; attributes?: Record<string, string> }>;
  headStyles?: Array<{ href?: string; content?: string }>;
  extraMetas?: Array<{ name?: string; property?: string; content: string }>;
  extraLinks?: Array<{ rel: string; href: string; [key: string]: any }>;
  inlineScripts?: string[];
}

const {
  title = "OMODA JAECOO | Tecnología con estilo.",
  description = "Dos marcas que comparten una misma esencia: diseño, tecnología y alto desempeño.",
  ogTitle = "OMODA JAECOO | Tecnología con estilo.",
  ogDescription = "Dos marcas que comparten una misma esencia: diseño, tecnología y alto desempeño.",
  ogImage = "https://www.omodajaecoo.com.pa/img/og-image.png",
  ogUrl = "https://www.omodajaecoo.com.pa/",
  canonical = "https://www.omodajaecoo.com.pa/",
  keywords = "OMODA, JAECOO, autos, Panamá, SUV, tecnología",
  headScripts = [],
  headStyles = [],
  extraMetas = [],
  extraLinks = [],
  inlineScripts = []
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="es_PA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="OMODA JAECOO Panamá" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@omodajaecoopa" />
    <meta name="twitter:creator" content="@omodajaecoopa" />

    <title>{title}</title>

    <!-- Preconectar con los dominios de Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Precargar la fuente -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Signika+Negative:wght@400;600&display=swap&subset=latin&display=optional"
    />
    
    <!-- Cargar la fuente con carga diferida -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Signika+Negative:wght@400;600&display=swap&subset=latin&display=optional"
      media="print"
      onload="this.media='all'"
      crossorigin="anonymous"
    />
    
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Signika+Negative:wght@400;600&display=swap&subset=latin"
      />
    </noscript>

    <!-- Estilos base -->

    
    <!-- Estilos del Layout -->
    <link rel="stylesheet" href="/src/styles/layout/layout.css"/>
    <link rel="stylesheet" href="/src/styles/layout/layout-mobile.css"/>
    <link rel="stylesheet" href="/src/styles/layout/layout-grid.css"/>

    <!-- Estilos adicionales desde props -->
    {headStyles.map((style, index) => (
      style.href 
        ? <link key={index} rel="stylesheet" href={style.href} />
        : <style key={index} set:html={style.content} />
    ))}

    <!-- Metas adicionales -->
    {extraMetas.map((meta, index) => (
      <meta key={index} {...meta} />
    ))}

    <!-- Links adicionales -->
    {extraLinks.map((link, index) => (
      <link key={index} {...link} />
    ))}

    <!-- Scripts externos -->
    {headScripts.map((script, index) => (
      script.src 
        ? <script key={index} src={script.src} {...script.attributes} />
        : <script key={index} set:html={script.content} />
    ))}

    <!-- Scripts inline -->
    {inlineScripts.map((script, index) => (
      <script key={index} set:html={script} />
    ))}
  </head>

  <body>
    <header class="main-header">
      <div class="header-container">
        <a href="/" class="logo-group">
          <span class="logo-text">OMODA</span>
          <span class="divider"></span>
          <span class="logo-text">JAECOO</span>
        </a>

        <nav class="nav-menu">
          <button
            id="btn-modelos"
            class="nav-link"
            aria-label="Ver modelos"
          >
            Modelos<span class="nav-underline"></span>
          </button>
          <a href="#cotiza" class="nav-link"
            >Cotiza tu auto<span class="nav-underline"></span></a
          >
          <a href="#sucursales" class="nav-link"
            >Sucursales<span class="nav-underline"></span></a
          >
          <a href="#postventa" class="nav-link"
            >Post Venta<span class="nav-underline"></span></a
          >
          <a href="#sobre" class="nav-link"
            >Sobre Nosotros<span class="nav-underline"></span></a
          >
        </nav>

        <div class="cta-group">
          <a href="#promociones" class="btn-promociones">
            <span class="pulse-dot"></span>
            Promociones del mes
          </a>
        </div>

        <button class="mobile-menu-btn" aria-label="Menú">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>

      <section class="mega-menu-catalog" id="megaMenuCatalog">
        <div class="container">
          <div class="catalog-header">
            <div class="title-group">
              <p class="subtitle">Catálogo</p>
              <h3 class="main-title">Nuestros modelos</h3>
            </div>
            {
              modelosDisponibles.length > 3 && (
                <button
                  id="btn-ver-todos"
                  class="view-all"
                  aria-label="Ver todos los modelos"
                >
                  Ver todos
                </button>
              )
            }
          </div>

          <div class="models-grid" id="grid-modelos">
            {
              modelosDisponibles.map((modelo, index) => (
                <div class="model-item" data-index={index}>
                  <ModelCard
                    brand={modelo.brand}
                    name={modelo.name}
                    badge={modelo.badge}
                    image={modelo.image}
                    urlPage={modelo.urlPage}
                    urlSpecs={modelo.urlSpecs}
                  />
                </div>
              ))
            }

            {
              modelosDisponibles.length === 0 && (
                <p class="no-models">Próximamente más modelos disponibles.</p>
              )
            }
          </div>
        </div>
      </section>
      
      <div class="mobile-nav" id="mobileMenu">
        <div class="mobile-nav-container">
          <a href="#cotiza" class="mobile-link">Cotiza tu auto</a>
          <a href="#sucursales" class="mobile-link">Sucursales</a>
          <a href="#postventa" class="mobile-link">Post Venta</a>
          <a href="#sobre" class="mobile-link">Sobre Nosotros</a>
          <a href="#promociones" class="mobile-btn-promo">
            Promociones del mes
          </a>
        </div>
      </div>
    </header>
    
    <main>
      <slot />
    </main>

 <style>
        :root {
            --ink: #0a0a0b;
            --ink-foreground: #ffffff;
            --brand: #e53935;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Signika Negative', 'Raleway', Arial, sans-serif;
        }

        .footer {
            position: relative;
            overflow: hidden;
            background: var(--ink);
            color: var(--ink-foreground);
        }

        .footer-gradient {
            height: 4px;
            width: 100%;
            background: linear-gradient(90deg, transparent, var(--brand), transparent);
        }

        .footer-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 64px 24px;
        }

        .footer-grid {
            display: grid;
            gap: 48px;
        }

        @media (min-width: 768px) {
            .footer-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* Columna 1 - Logo y redes sociales */
        .footer-logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .footer-logo span {
            font-size: 20px;
            font-weight: 900;
            letter-spacing: 0.2em;
        }

        .footer-logo .divider {
            height: 20px;
            width: 1px;
            background: rgba(255, 255, 255, 0.3);
        }

        .footer-description {
            margin-top: 20px;
            max-width: 384px;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
            line-height: 1.6;
        }

        .footer-social {
            margin-top: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .social-link {
            display: flex;
            height: 40px;
            width: 40px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            transition: all 0.3s ease;
            background: transparent;
        }

        .social-link:hover {
            border-color: transparent;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        /* Columna 2 - Navegación */
        .footer-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            color: rgba(255, 255, 255, 0.5);
        }

        .footer-nav {
            margin-top: 20px;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-nav a {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-nav a:hover {
            color: #ffffff;
        }

        /* Columna 3 - Apps */
        .app-buttons {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .app-button {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 10px 20px;
            font-size: 14px;
            text-decoration: none;
            color: #ffffff;
            transition: border-color 0.3s ease;
        }

        .app-button:hover {
            border-color: rgba(255, 255, 255, 0.4);
        }

        .app-button svg {
            width: 20px;
            height: 20px;
            fill: currentColor;
        }

        /* Footer bottom */
        .footer-bottom {
            margin-top: 48px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 24px;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.4);
        }

        @media (min-width: 768px) {
            .footer-bottom {
                flex-direction: row;
            }
        }

        .footer-bottom p {
            margin: 0;
        }
    </style>
<footer class="footer">
        <!-- Línea degradada superior -->
        <div class="footer-gradient"></div>

        <div class="footer-container">
            <div class="footer-grid">
                
                <!-- Columna 1: Logo y redes sociales -->
                <div>
                    <div class="footer-logo">
                        <span>OMODA</span>
                        <span class="divider"></span>
                        <span>JAECOO</span>
                    </div>
                    <p class="footer-description">
                        Distribuidor oficial respaldado por Grupo Silaba. Tu nuevo SUV te espera.
                    </p>
                    <div class="footer-social">
                        <!-- Instagram -->
                        <a href="#" aria-label="Instagram" class="social-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                <circle cx="12" cy="12" r="4"></circle>
                                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
                            </svg>
                        </a>
                        
                        <!-- Facebook -->
                        <a href="#" aria-label="Facebook" class="social-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M22 12a10 10 0 10-11.6 9.9v-7H8v-3h2.4V9.5c0-2.4 1.4-3.7 3.6-3.7 1 0 2 .2 2 .2v2.3h-1.2c-1.2 0-1.5.7-1.5 1.5V12h2.6l-.4 3h-2.2v7A10 10 0 0022 12z"></path>
                            </svg>
                        </a>
                        
                        <!-- TikTok -->
                        <a href="#" aria-label="TikTok" class="social-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19.6 6.7a4.8 4.8 0 01-3-1.7 4.8 4.8 0 01-1.1-3H12v12.4a2.8 2.8 0 11-2-2.7v-3.4a6.1 6.1 0 105.5 6V9.7a8 8 0 004.6 1.5V7.8a4.8 4.8 0 01-.5-1.1z"></path>
                            </svg>
                        </a>
                        
                        <!-- YouTube -->
                        <a href="#" aria-label="YouTube" class="social-link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23 7.5a3 3 0 00-2.1-2.1C19 5 12 5 12 5s-7 0-8.9.4A3 3 0 001 7.5 31 31 0 001 12a31 31 0 000 4.5 3 3 0 002.1 2.1C5 19 12 19 12 19s7 0 8.9-.4a3 3 0 002.1-2.1 31 31 0 000-9zM10 15.5v-7l6 3.5-6 3.5z"></path>
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Columna 2: Navegación -->
                <div>
                    <h4 class="footer-title">Navegación</h4>
                    <ul class="footer-nav">
                        <li><a href="#modelos">Modelos</a></li>
                        <li><a href="#cotiza">Agendar Cita</a></li>
                        <li><a href="#sucursales">Sucursales</a></li>
                        <li><a href="#postventa">Post Venta</a></li>
                        <li><a href="#sobre">Sobre Nosotros</a></li>
                    </ul>
                </div>

                <!-- Columna 3: Apps -->
                <div>
                    <h4 class="footer-title">Descarga la app</h4>
                    <div class="app-buttons">
                        <a href="#" class="app-button">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M3 20.5V3.5c0-.6.3-1.1.8-1.4l10.6 9.9L3.8 21.9c-.5-.3-.8-.8-.8-1.4zM16.8 13.7l3-2.8c.7-.4.7-1.4 0-1.8l-3-2.8-3.4 3.7 3.4 3.7zM5.2 2.6l9.9 5.7-2.9 3.2-7-8.9zM12.2 12.5l2.9 3.2-9.9 5.7 7-8.9z"></path>
                            </svg>
                            Google Play
                        </a>
                        <a href="#" class="app-button">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M17.5 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.9-.8-3.1-.8-1.6 0-3 .9-3.9 2.4-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.8 3.1-.8s1.9.8 3.1.7c1.3 0 2.1-1.1 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.6-1-2.6-3.7zM15.2 5.8c.6-.8 1.1-1.9 1-3-.9 0-2 .6-2.7 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.5 2.7-1.3z"></path>
                            </svg>
                            App Store
                        </a>
                    </div>
                </div>

            </div>

            <!-- Footer bottom -->
            <div class="footer-bottom">
                <p>© 2026 Grupo Silaba. Todos los derechos reservados.</p>
                <p>Diseño con visión de futuro.</p>
            </div>
        </div>
    </footer>


    
    <!-- Scripts al final del body para mejor performance -->
    <script is:inline src="./src/scripts/layout/layout.js" defer></script>
  </body>
</html>