---
import ModelCard from "../components/ModelCard.astro";
import { misModelos } from "../data/modelos.js";

// Filtramos: solo pasan los modelos que tienen ambos campos con texto
const modelosDisponibles = misModelos.filter(
  (modelo) =>
    modelo.urlPage &&
    modelo.urlPage.trim() !== "" &&
    modelo.urlSpecs &&
    modelo.urlSpecs.trim() !== "",
);




export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  canonical?: string;
  keywords?: string;
  // Para scripts adicionales
  headScripts?: Array<{ src?: string; content?: string; attributes?: Record<string, string> }>;
  // Para estilos adicionales
  headStyles?: Array<{ href?: string; content?: string }>;
  // Para metas adicionales
  extraMetas?: Array<{ name?: string; property?: string; content: string }>;
  // Para links adicionales
  extraLinks?: Array<{ rel: string; href: string; [key: string]: any }>;
  // Scripts inline
  inlineScripts?: string[];
}

const {
  title = "OMODA JAECOO | Tecnología con estilo.",
  description = "Dos marcas que comparten una misma esencia: diseño, tecnología y alto desempeño.",
  ogTitle = "OMODA JAECOO | Tecnología con estilo.",
  ogDescription = "Dos marcas que comparten una misma esencia: diseño, tecnología y alto desempeño.",
  ogImage = "https://www.omodajaecoo.com.pa/images/og-image.png",
  ogUrl = "https://www.omodajaecoo.com.pa/",
  canonical = "https://www.omodajaecoo.com.pa/",
  keywords = "OMODA, JAECOO, autos, Panamá, SUV, tecnología",
  headScripts = [],
  headStyles = [],
  extraMetas = [],
  extraLinks = [],
  inlineScripts = []
} = Astro.props;

---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="es_PA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="OMODA JAECOO Panamá" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@omodajaecoopa" />
    <meta name="twitter:creator" content="@omodajaecoopa" />

    <title>{title}</title>

    <!-- Preconectar con los dominios de Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Precargar la fuente -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Signika+Negative:wght@400;600&display=swap&subset=latin&display=optional"
    />
    
    <!-- Cargar la fuente con carga diferida -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Signika+Negative:wght@400;600&display=swap&subset=latin&display=optional"
      media="print"
      onload="this.media='all'"
      crossorigin="anonymous"
    />
    
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Signika+Negative:wght@400;600&display=swap&subset=latin"
      />
    </noscript>

    <!-- Estilos base -->
    <link rel="stylesheet" href="/styles/estilos.css" />

    <!-- Estilos adicionales desde props -->
    {headStyles.map((style, index) => (
      style.href 
        ? <link key={index} rel="stylesheet" href={style.href} />
        : <style key={index} set:html={style.content} />
    ))}

    <!-- Metas adicionales -->
    {extraMetas.map((meta, index) => (
      <meta key={index} {...meta} />
    ))}

    <!-- Links adicionales -->
    {extraLinks.map((link, index) => (
      <link key={index} {...link} />
    ))}

    <!-- Scripts externos -->
    {headScripts.map((script, index) => (
      script.src 
        ? <script key={index} src={script.src} {...script.attributes} />
        : <script key={index} set:html={script.content} />
    ))}

    <!-- Scripts inline -->
    {inlineScripts.map((script, index) => (
      <script key={index} set:html={script} />
    ))}
  </head>

  <body>
    <header class="main-header">
      <div class="header-container">
        <a href="#" class="logo-group">
          <span class="logo-text">OMODA</span>
          <span class="divider"></span>
          <span class="logo-text">JAECOO</span>
        </a>

        <nav class="nav-menu">
          <button
            id="btn-modelos"
            class="nav-link"
            style="background: none; border: none; cursor: pointer;"
          >
            Modelos<span class="nav-underline"></span>
          </button>
          <a href="#cotiza" class="nav-link"
            >Cotiza tu auto<span class="nav-underline"></span></a
          >
          <a href="#sucursales" class="nav-link"
            >Sucursales<span class="nav-underline"></span></a
          >
          <a href="#postventa" class="nav-link"
            >Post Venta<span class="nav-underline"></span></a
          >
          <a href="#sobre" class="nav-link"
            >Sobre Nosotros<span class="nav-underline"></span></a
          >
        </nav>

        <div class="cta-group">
          <a href="#promociones" class="btn-promociones">
            <span class="pulse-dot"></span>
            Promociones del mes
          </a>
        </div>

        <button class="mobile-menu-btn" aria-label="Menú">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>

      <section class="mega-menu-catalog">
        <div class="container">
          <div class="catalog-header">
            <div class="title-group">
              <p class="subtitle">Catálogo</p>
              <h3 class="main-title">Nuestros modelos</h3>
            </div>
            <!-- Cambiamos el link por un botón o le damos un ID para controlarlo -->
            {
              modelosDisponibles.length > 3 && (
                <button
                  id="btn-ver-todos"
                  class="view-all"
                  style="background:none; border:none; cursor:pointer;"
                >
                  Ver todos
                </button>
              )
            }
          </div>

          <div class="models-grid" id="grid-modelos">
            {
              modelosDisponibles.map((modelo, index) => (
                /* Quitamos el ternario y solo dejamos la clase base */
                <div class="model-item">
                  <ModelCard
                    brand={modelo.brand}
                    name={modelo.name}
                    badge={modelo.badge}
                    image={modelo.image}
                    urlPage={modelo.urlPage}
                    urlSpecs={modelo.urlSpecs}
                  />
                </div>
              ))
            }

            {
              modelosDisponibles.length === 0 && (
                <p>Próximamente más modelos disponibles.</p>
              )
            }
          </div>
        </div>
      </section>
      <div class="mobile-nav" id="mobileMenu">
        <div class="mobile-nav-container">
          <a href="#cotiza" class="mobile-link">Cotiza tu auto</a>
          <a href="#sucursales" class="mobile-link">Sucursales</a>
          <a href="#postventa" class="mobile-link">Post Venta</a>
          <a href="#sobre" class="mobile-link">Sobre Nosotros</a>

          <a href="#promociones" class="mobile-btn-promo">
            Promociones del mes
          </a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  :root {
    --brand: #eab308; /* Tu color amarillo/dorado */
    --ink: #000000; /* Tu color de fondo oscuro */
  }

  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: all 0.3s ease;
    /* El degradado usa color-mix o fallback a negro con transparencia */
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--ink) 70%, transparent),
      transparent
    );
    backdrop-filter: blur(4px);
    border-bottom: 1px solid transparent;
  }

  .header-container {
    max-width: 1280px; /* max-w-7xl */
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem; /* py-4 px-6 */
  }

  /* Logos */
  .logo-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-text {
    font-size: 1.125rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #ffffff;
  }

  .divider {
    height: 1rem;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.3);
  }

  /* Navegación */
  .nav-menu {
    display: none; /* Oculto en móvil */
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .nav-menu {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    font-size: 0.875rem;
    font-medium: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-underline {
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    height: 2px;
    width: 0;
    background-color: var(--brand);
    transition: width 0.3s ease;
  }

  .nav-link:hover .nav-underline {
    width: 100%;
  }

  /* Botón de Promociones */
  .cta-group {
    display: none;
  }

  @media (min-width: 1024px) {
    .cta-group {
      display: flex;
    }
  }

  .btn-promociones {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--brand);
    color: #ffffff;
    padding: 0.625rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease;
  }

  .btn-promociones:hover {
    transform: scale(1.05);
  }

  .pulse-dot {
    height: 0.5rem;
    width: 0.5rem;
    background-color: #ffffff;
    border-radius: 50%;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Botón Móvil */
  .mobile-menu-btn {
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    color: #ffffff;
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-nav {
    display: none; /* Cambiado de block a none */
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background-color: var(--ink);
  }

  /* Clase para activar el menú móvil */
  .mobile-nav.is-open {
    display: block;
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Asegurarnos que en desktop siga oculto aunque tenga la clase is-open */
  @media (min-width: 1024px) {
    .mobile-nav,
    .mobile-nav.is-open {
      display: none;
    }
  }

  .mobile-nav-container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* gap-1 */
    padding: 1rem 1.5rem; /* py-4 px-6 */
  }

  .mobile-link {
    display: block;
    border-radius: 0.375rem; /* rounded-md */
    padding: 0.75rem; /* py-3 px-3 */
    font-size: 0.875rem; /* text-sm */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em; /* tracking-wider */
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mobile-link:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .mobile-btn-promo {
    margin-top: 0.5rem; /* mt-2 */
    display: block;
    text-align: center;
    border-radius: 9999px; /* rounded-full */
    padding: 0.75rem 1.25rem;
    font-size: 0.75rem; /* text-xs */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    background-color: var(--brand);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .mobile-btn-promo:hover {
    opacity: 0.9;
  }

  :root {
    --brand-color: #00f2ff; /* Color cian de OMODA */
    --bg-dark: #0a0a0a;
    --card-bg: rgba(255, 255, 255, 0.03);
    --card-border: rgba(255, 255, 255, 0.05);
  }

  .mega-menu-catalog {
    display: none;
    top: 100%; /* Justo debajo del header */
    left: 0;

    background-color: var(--bg-dark);
    padding: 40px 24px;
    z-index: 100;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Clase que aplicaremos con JS para mostrarlo */
  .mega-menu-catalog.is-active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Encabezado */
  .catalog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
  }

  .subtitle {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .title-group {
    .main-title {
      font-size: 24px;
      font-weight: 900;
      text-transform: uppercase;
      margin: 4px 0 0 0;
      color: #ffffff;
    }
  }

  .view-all {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.3s;
  }

  .view-all:hover {
    color: white;
  }

  /* Grid */
  .models-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (min-width: 1280px) {
    .models-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* Card Estilos */
  .model-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 16px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .model-card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Etiquetas de Marca */
  .brand-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .brand-omoda {
    color: var(--brand-color);
  }
  .brand-jaecoo {
    color: rgba(255, 255, 255, 0.5);
  }

  /* Contenedor de Imagen y Glow */
  .car-image-container {
    position: relative;
    height: 96px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .glow-effect {
    position: absolute;
    bottom: 8px;
    left: 16px;
    right: 16px;
    height: 8px;
    border-radius: 50%;
    filter: blur(12px);
    opacity: 0.3;
    transition: opacity 0.3s;
  }

  .brand-omoda-bg {
    background: var(--brand-color);
  }
  .brand-jaecoo-bg {
    background: white;
  }

  .model-card:hover .glow-effect {
    opacity: 0.6;
  }

  .car-img {
    max-width: 190px;
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform 0.5s;
  }

  .model-card:hover .car-img {
    transform: scale(1.1);
  }

  /* Info del Modelo */
  .model-info {
    margin-top: 12px;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .model-name {
    font-size: 24px;
    font-weight: 900;
    color: white;
  }

  .model-badge {
    font-size: 10px;
    font-weight: 700;
  }

  /* Botones inferiores */
  .card-actions {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .btn-explore,
  .btn-specs {
    padding: 4px;
    text-align: center;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 6px;
    transition: 0.3s;
  }

  .btn-explore {
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: white;
  }
  .model-card:hover .btn-explore {
    border-color: rgba(255, 255, 255, 0.4);
  }
  .btn-specs {
    color: rgba(255, 255, 255, 0.5);
  }
  .model-card:hover .btn-specs {
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 1023px) {
    .mega-menu-catalog {
      position: static; /* En móvil se apila, no flota */
      display: none; /* Oculto por defecto */
      padding: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Cuando el menú móvil está abierto, mostramos el catálogo también */
    .mobile-nav.is-open + .mega-menu-catalog, /* Si están hermanos */
  .is-open .mega-menu-catalog,
  .mega-menu-catalog.is-active-mobile {
      display: block;
    }

    .models-grid {
      grid-template-columns: repeat(
        3,
        1fr
      ); /* 2 columnas en móvil para que quepan */
      gap: 10px;
    }
  }

  /* Ocultar acciones del card en dispositivos móviles (menos de 1024px) */
  @media (max-width: 1023px) {
    .card-actions {
      display: none;
    }

    /* Opcional: Ajustar el padding inferior del card para que no quede mucho espacio vacío */
    .model-card {
      padding-bottom: 20px;
    }

    /* Opcional: Hacer el nombre un poco más pequeño en móvil si es necesario */
    .model-name {
      font-size: 20px;
    }
  }

  /* Escondemos los modelos que tengan la clase .model-hidden */
  .model-hidden {
    display: none;
  }

  /* Cuando el contenedor tenga la clase 'show-all', mostramos los ocultos */
  .models-grid.show-all .model-hidden {
    display: block;
    animation: fadeIn 0.5s ease forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const btn = document.getElementById("btn-ver-todos");
  const grid = document.getElementById("grid-modelos");

  if (btn && grid) {
    btn.addEventListener("click", () => {
      grid.classList.toggle("show-all");

      // Opcional: Cambiar el texto del botón
      if (grid.classList.contains("show-all")) {
        btn.textContent = "Ver menos";
      } else {
        btn.textContent = "Ver todos";
      }
    });
  }
</script>

<script>
  const btnMobile = document.querySelector(".mobile-menu-btn");
  const mobileNav = document.getElementById("mobileMenu");
  const megaMenu = document.querySelector(".mega-menu-catalog");
  const btnModelosDesktop = document.getElementById("btn-modelos");
  const viewAllBtn = document.querySelector(".view-all");

  if (viewAllBtn && megaMenu) {
    viewAllBtn.addEventListener("click", (e) => {
      // Evitamos que salte al ID #modelos o recargue
      e.preventDefault();
      e.stopPropagation();
      // Expandimos el grid
      megaMenu.classList.add("is-expanded");
    });
  }

  // Función para cerrar TODO
  const closeAllMenus = () => {
    mobileNav?.classList.remove("is-open");
    megaMenu?.classList.remove("is-active");
    megaMenu?.classList.remove("is-active-mobile");
    mobileNav?.classList.remove("is-open");
    megaMenu?.classList.remove("is-active", "is-active-mobile", "is-expanded");
    // Resetear icono a hamburguesa
    const svg = btnMobile?.querySelector("svg");
    if (svg) svg.innerHTML = '<path d="M3 6h18M3 12h18M3 18h18"></path>';
  };

  // 1. Manejo del Menú Hamburguesa (Mobile)
  btnMobile?.addEventListener("click", () => {
    const isOpen = mobileNav?.classList.toggle("is-open");

    // Sincronización: El catálogo móvil sigue estrictamente al botón hamburguesa
    if (window.innerWidth < 1024) {
      megaMenu?.classList.toggle("is-active-mobile", isOpen);
      // Limpiamos la clase de desktop por si acaso
      megaMenu?.classList.remove("is-active");
    }
    // Cambiar icono
    const svg = btnMobile.querySelector("svg");
    if (isOpen) {
      svg.innerHTML = '<path d="M18 6L6 18M6 6l12 12"></path>';
    } else {
      svg.innerHTML = '<path d="M3 6h18M3 12h18M3 18h18"></path>';
    }
  });
  // 2. Manejo del botón Modelos (Desktop)
  btnModelosDesktop?.addEventListener("click", (e) => {
    if (window.innerWidth >= 1024) {
      e.preventDefault();
      e.stopPropagation(); // Evita que el clic se propague al document
      megaMenu?.classList.toggle("is-active");
    }
  });

  // 3. Limpiador de Resincronización (Resize)
  // Si el usuario cambia el tamaño de la ventana, cerramos todo para evitar "fantasmas"
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      // Si pasamos a Desktop, cerramos lo que sea de móvil
      mobileNav?.classList.remove("is-open");
      megaMenu?.classList.remove("is-active-mobile");
      const svg = btnMobile?.querySelector("svg");
      if (svg) svg.innerHTML = '<path d="M3 6h18M3 12h18M3 18h18"></path>';
    } else {
      // Si pasamos a Móvil, cerramos lo que sea de desktop
      megaMenu?.classList.remove("is-active");
    }
  });

  // 4. Cerrar al hacer clic fuera (Solo Desktop)
  document.addEventListener("click", (e) => {
    if (window.innerWidth >= 1024) {
      if (!e.target.closest(".main-header")) {
        megaMenu?.classList.remove("is-active");
      }
    }
  });

  // 5. Cerrar al hacer clic en un enlace
  document.addEventListener("click", (e) => {
    if (e.target.closest(".mobile-link") || e.target.closest(".model-card")) {
      closeAllMenus();
    }
  });
</script>

<style>
  /* 1. Comportamiento por defecto (Mobile) */
  .model-item {
    display: block;
  }

  /* Ocultar desde el 4to en adelante (índice 3+) */
  .model-item:nth-child(n + 4) {
    display: none;
  }

  /* 2. Comportamiento en Desktop (1024px o más) */
  @media (min-width: 1024px) {
    /* Reseteamos el corte de mobile para que se vean hasta 5 */
    .model-item:nth-child(n + 4) {
      display: block;
    }

    /* Ocultar desde el 6to en adelante (índice 5+) */
    .model-item:nth-child(n + 6) {
      display: none;
    }
  }

  /* 3. Lógica de expansión cuando se hace clic en el botón */
  .models-grid.show-all .model-item {
    display: block !important;
    animation: fadeIn 0.5s ease forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Ocultar el botón si no hay elementos ocultos reales */
  #btn-ver-todos {
    display: none;
  }

  /* Mostrar botón en mobile si hay más de 3 */
  @media (max-width: 1023px) {
    .models-grid:has(.model-item:nth-child(4)) ~ .catalog-header #btn-ver-todos,
    .catalog-header:has(~ .models-grid .model-item:nth-child(4))
      #btn-ver-todos {
      display: flex;
    }
  }

  /* Mostrar botón en desktop si hay más de 5 */
  @media (min-width: 1024px) {
    .models-grid:has(.model-item:nth-child(6)) ~ .catalog-header #btn-ver-todos,
    .catalog-header:has(~ .models-grid .model-item:nth-child(6))
      #btn-ver-todos {
      display: flex;
    }
  }
</style>
