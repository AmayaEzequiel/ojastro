---
// src/pages/modelos/c7.astro
import Layout from "../layouts/default.astro";

const pageTitle = "Omoda C7 | Maneja como lo imaginaste";
const pageDescription = "Tecnología moderna, diseño práctico y el confort que tu vida exige. Descubre el Omoda C7 con motor 1.6 Turbo, 183 Hp y sistemas ADAS.";
const pageKeywords = "Omoda C7, SUV, 1.6 Turbo, Panamá, ADAS, tecnología";
const canonical = "https://www.omodajaecoo.com.pa/modelos/c7";
const ogImage = "https://www.omodajaecoo.com.pa/img/og-c7.png";

const headStyles = [
  { href: "/src/styles/c7/vendor.css" },
  { href: "/src/styles/c7/main-v2.css" },
  { href: "/src/styles/c7/omoda.css" },
  { href: "/src/styles/c7/c7-custom.css" },
];

const headScripts = [
  { 
    src: "https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js",
    attributes: {
      integrity: "sha512-3gJwYpMe3QewGELv8k/BX9vcqhryRdzRMxVfq6ngyWXwo03GFEzjsUm8Q7RZcHPHksttq7/GFoxjCVUjkjvPdw==",
      crossorigin: "anonymous",
      referrerpolicy: "no-referrer"
    }
  },
  { src: "/src/scripts/c7/app.bundle.min.js" },
  { src: "/src/scripts/c7/vendor.js" },
  { src: "/src/scripts/c7/main.js" },
];

const inlineScripts = [
  `const mainURL = 'https://omodajaecoo.com.pa/';`,
  // Los scripts de util.js se moverán a archivos externos
];

// Datos de las características técnicas
const stats = {
  motor: "1.6 Turbo",
  traccion: "4x2",
  potencia: "183 Hp",
  torque: "275 Nm"
};

// Datos del slider exterior
const exteriorSlides = [
  {
    title: "Parrilla en forma de X",
    text: "",
    image: "/img/c7/font.png",
    imageMobile: "https://omodajaecoo.com.pa/backstage/files/sliders/image_mobile/bbcb9e20-2a9a-41bb-8254-1989de502376/Screenshot%202025-08-22%20at%202.34.12%E2%80%AFPM.png",
    colorClass: "slide-color-light"
  },
  {
    title: "Luces Hyper Red en forma de 7's",
    text: "",
    image: "/img/c7/luces.png",
    imageMobile: "https://omodajaecoo.com.pa/backstage/files/sliders/image_mobile/cf7976b1-c72b-4fbb-85aa-b4f2e0f6f491/Screenshot%202025-08-22%20at%203.52.13%E2%80%AFPM.png",
    colorClass: "slide-color-light"
  }
];

// Datos del slider interior
const interiorSlides = [
  {
    title: "Interior tecnológico y espacioso",
    text: "¡Pantalla de 15.6\", luz ambiental, ventilación de asientos, carga inalámbrica del celular, y más!",
    image: "/img/c7/interior.png",
    imageMobile: "/img/c7/interior.png"
  },
  {
    title: "Un descanso cuando lo necesitas",
    text: "Los asientos del C7 se reclinan de manera automática hasta 180°, permitiéndote desconectarte por un momento. Con su temporizador integrado, puedes relajarte con tranquilidad sin perder la noción del tiempo.",
    image: "/img/c7/omoda-c7-interno-negro-2646x1476.jpg",
    imageMobile: "/img/c7/omoda-c7-interno-negro-2646x1476.jpg"
  }
];

// Datos de sistemas ADAS
const adasFeatures = [
  {
    title: "IES - Dirección de Emergencia Inteligente",
    text: "Ayuda al conductor a maniobrar de forma segura en situaciones de emergencia, aplicando asistencia en la dirección para evitar obstáculos o colisiones.",
    image: "/img/c7/ies.png"
  },
  {
    title: "ACC - Control Crucero Adaptativo",
    text: "Mantiene automáticamente una velocidad constante y regula la distancia con el vehículo de adelante, frenando o acelerando según el tráfico.",
    image: "/img/c7/acc.png"
  },
  {
    title: "AEB - Frenado Automático de Emergencia",
    text: "Detecta riesgos de colisión y aplica los frenos de manera automática si el conductor no reacciona a tiempo.",
    image: "/img/c7/aeb.png"
  },
  {
    title: "LCC - Control de Centrado en el Carril",
    text: "Mantiene al vehículo en el centro del carril, corrigiendo suavemente la dirección cuando detecta desvíos.",
    image: "/img/c7/lcc.png"
  },
  {
    title: "TJA - Asistencia en Tráfico Pesado",
    text: "Combina ACC y LCC para manejar de forma semiautónoma en embotellamientos: mantiene distancia, velocidad baja y el vehículo centrado en el carril.",
    image: "/img/c7/tja.png"
  }
];
6
// Datos de colores
const colores = [
  { id: "verde-oscuro", nombre: "Verde Oscuro", imagen: "/img/c7/Verde.jpeg", color: "#1a5556" },
  { id: "gris-acerado", nombre: "Gris Acerado", imagen: "/img/c7/Gris_claro.Jpg", color: "#6e797b" },
  { id: "gris-oscuro", nombre: "Gris Mate", imagen: "/img/c7/Girs.jpeg", color: "#2b333e", activo: true },
  { id: "blanco", nombre: "Blanco", imagen: "/img/c7/Blanco.jpeg", color: "#ffffff" },
  { id: "negro", nombre: "Negro", imagen: "/img/c7/Negro.jpeg", color: "#000000" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonical}
  ogImage={ogImage}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  headStyles={headStyles}
  headScripts={headScripts}
>

  <main class="main">
    <!-- Hero Banner -->
    <div class="promo">
      <picture class="promo__image-wrapper promo__image-wrapper-desktop move-out animation-activated">
        <source media="(orientation: portrait)" srcset="/img/c7/BM - C7.png 768w">
        <source srcset="">
        <img class="promo__image" src="/img/c7/BP - C7.png" alt="Omoda C7">
      </picture>
      <div class="promo__content-wrapper datos_banner">
        <div>
          <div class="txt_combustible">Nuevo <span>Omoda</span><br></div>
          <img class="logo_banner" src="/img/c7/LOGOS_C7.png" alt="C7">
        </div>
        <div class="dos_columnas_banner"></div>
      </div>
      <div class="promo__content-wrapper">
        <div style="display: flex;">
          <a href="/ficha_tecnica/c7.pdf"
            class="button promo__button promo__button--light observer-word-up animation-activated"
            style="text-decoration: none;">FICHA TÉCNICA</a>
          <a href="https://cotizar.omodajaecoo.com.pa"
            class="button promo__button promo__button--light observer-word-up animation-activated"
            style="text-decoration: none; margin-left: 5px;">COTIZAR</a>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="stats content">
      <div class="stats__header">
        <div class="stats__title">Donde la innovación cobra sentido</div>
        <div class="stats__text observer-fade-in animation-activated">
          Tecnología moderna, diseño práctico y el confort que tu vida exige.
        </div>
      </div>
      <div class="jc_tab_numbers"></div>
      <div id="content_tab_luxury" class="stats__numbers">
        <div class="stats__number">
          <p class="stats__number-name">MOTOR</p>
          <p class="js-value-counter stats__number-value">{stats.motor}</p>
        </div>
        <div class="stats__number">
          <p class="stats__number-name">TRACCIÓN</p>
          <p class="js-value-counter stats__number-value">{stats.traccion}</p>
        </div>
        <div class="stats__number">
          <p class="stats__number-name">POTENCIA</p>
          <p class="js-value-counter stats__number-value">{stats.potencia}</p>
        </div>
        <div class="stats__number">
          <p class="stats__number-name">TORQUE</p>
          <p class="js-value-counter stats__number-value">{stats.torque}</p>
        </div>
      </div>
    </div>

    <!-- Equipamiento Exterior -->
    <div class="model__tech">
      <div class="content title-text">
        <div class="title-text__content-wrapper title-text--with-title title-text--no-subtitle title-text--only-one-text">
          <h3 class="title-text__title observer-fade-in animation-activated">EQUIPAMIENTO EXTERIOR</h3>
          <p class="title-text__text observer-fade-in animation-activated">
            Parrilla frontal en "X", un diseño exterior de líneas definidas y luces Hyper Red en forma de 7: cada elemento exterior está diseñado para aportar visibilidad, seguridad y una identidad única en la carretera.
          </p>
        </div>
      </div>
      <div class="character-slider-container content--only-lateral">
        <div class="character-slider swiper js-slider-character">
          <div class="character-slider__container swiper-wrapper">
            {exteriorSlides.map((slide, index) => (
              <div class="character-slider__item swiper-slide" style="width: 1220px; margin-right: 40px;">
                <div class="character-slider__image">
                  <picture>
                    <source media="(max-width: 767px)" srcset={slide.imageMobile}>
                    <source srcset="">
                    <img src={slide.image} alt={slide.title}>
                  </picture>
                </div>
                <div class="character-slider__content">
                  <p class={`character-slider__title ${slide.colorClass}`}>{slide.title}</p>
                  <p class={`character-slider__text ${slide.colorClass}`}>{slide.text}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="js-slider-character-pagination character-slider__pagination"></div>
          <div class="js-slider-character-navigation character-slider__navigation"></div>
        </div>
      </div>
    </div>

    <!-- Equipamiento Interior -->
    <div class="model__tech jc_cambio_color_blan3">
      <div class="content title-text jc_cambio_color_blan3">
        <div class="title-text__content-wrapper title-text--with-title title-text--no-subtitle title-text--only-one-text">
          <h3 class="title-text__title jc_txt1_cambio observer-fade-in animation-activated">EQUIPAMIENTO INTERIOR</h3>
          <p class="title-text__text jc_txt2_cambio observer-fade-in animation-activated">
            Interior cómodo, silencioso y funcional, pensado para ofrecer bienestar en cada viaje.
          </p>
        </div>
      </div>
      <div class="character-slider-container content--only-lateral">
        <div class="character-slider swiper js-slider-character">
          <div class="character-slider__container swiper-wrapper">
            {interiorSlides.map((slide, index) => (
              <div class="character-slider__item swiper-slide" style="width: 1220px; margin-right: 40px;">
                <div class="character-slider__image">
                  <picture>
                    <source media="(max-width: 767px)" srcset={slide.imageMobile}>
                    <source srcset="">
                    <img src={slide.image} alt={slide.title}>
                  </picture>
                </div>
                <div class="character-slider__content">
                  <p class="character-slider__title slide-color-245">{slide.title}</p>
                  <p class="character-slider__text slide-color-245">{slide.text}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="js-slider-character-pagination character-slider__pagination"></div>
          <div class="js-slider-character-navigation character-slider__navigation"></div>
        </div>
      </div>
    </div>

    <!-- Sistemas de Seguridad ADAS -->
    <div class="model__features model__features--bright jc_cambio_color_blan3">
      <div class="content title-text jc_cambio_color_blan3">
        <div class="title-text__content-wrapper title-text--with-title title-text--no-subtitle title-text--only-one-text">
          <h3 class="title-text__title observer-fade-in animation-activated">SISTEMAS DE SEGURIDAD ADAS</h3>
          <p class="title-text__text observer-fade-in animation-activated">
            Tecnología de asistencia avanzada que trabaja contigo para ofrecer una conducción más segura y confiable.
          </p>
        </div>
      </div>
      <div class="feature-block content feature-block--dark jc_cambio_color_blan3">
        <div class="feature-slider js-slider-triple">
          <div class="feature-slider__container swiper-wrapper">
            {adasFeatures.map((feature, index) => (
              <div class="feature-slider__item swiper-slide" style="width: 590px; margin-right: 40px;">
                <div class="feature-content">
                  <picture>
                    <source srcset="">
                    <img class="feature-content__image" src={feature.image} alt={feature.title}>
                  </picture>
                  <h3 class="feature-content__title">{feature.title}</h3>
                  <div class="feature-content__text">{feature.text}</div>
                </div>
              </div>
            ))}
          </div>
          <div class="js-slider-triple-pagination feature-slider__pagination"></div>
        </div>
      </div>
    </div>

    <!-- Colores -->
    <div class="model__tech jc_cambio_color_blan3" style="padding-bottom: 10px;">
      <div class="content title-text jc_cambio_color_blan" style="padding: 16px 120px;">
        <div class="title-text__content-wrapper title-text--no-title">
          <h3 class="title-text__title">Tu C7, a tu manera</h3>
          <h4 class="title-text__subtitle jc_more_padding" style="padding-top: 2px;">
            La personalización también forma parte de una experiencia pensada para ti. Cada color refleja tu estilo y te acompaña en cada trayecto con personalidad propia.
          </h4>
        </div>
      </div>

      {colores.map((color, index) => (
        <div 
          id={`slider-${color.id}`} 
          class="character-slider-container content--only-lateral slide_big_new"
          style={`padding: 0px; display: ${color.activo ? 'block' : 'none'};`}
        >
          <div class="character-slider swiper js-slider-character">
            <div class="character-slider__container swiper-wrapper">
              <div class="character-slider__item swiper-slide" style="width: 1460px; margin-right: 40px;">
                <div class="character-slider__image">
                  <picture>
                    <source srcset="">
                    <img src={color.imagen} alt={`C7 Color ${color.nombre}`}>
                  </picture>
                </div>
              </div>
            </div>
            <div class="js-slider-character-button-next btn_next">
              <img src="/img/c7/arrow-right-tabs_cars.svg" alt="Siguiente">
            </div>
            <div class="js-slider-character-button-prev btn_prev">
              <img src="/img/c7/arrow-left-tabs_cars.svg" alt="Anterior">
            </div>
            <div class="js-slider-character-pagination character-slider__pagination character-slider__pagination2 character-slider__pagination3"></div>
            <div class="js-slider-character-navigation character-slider__navigation"></div>
          </div>
        </div>
      ))}

      <div class="jc_tab_numbers jc_tab_numbers2">
        {colores.map((color, index) => (
          <button 
            type="button" 
            id={color.id} 
            class={`jc_cta_tab newtabs slider_button${color.activo ? ' slider_button_active' : ''}`}
          >
            {color.nombre} 
            <div class="tabs_news" style={`background-color: ${color.color};`}></div>
          </button>
        ))}
      </div>
    </div>

    <!-- CTA Final -->
    <div class="content title-text jc_cambio_color_blan" style="padding: 16px 120px;">
      <div class="title-text__content-wrapper title-text--no-title">
        <h4 class="title-text__subtitle jc_more_padding" style="padding-top: 0;">
          Estás más cerca de manejarlo
        </h4>
        <a href="https://cotizar.omodajaecoo.com.pa/" class="btn1_jc">COTÍZALO HOY</a>
      </div>
    </div>

    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KZ7C5J9K" 
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  </main>

</Layout>

<script is:inline>
  // Script que maneja las tabs de colores
  document.addEventListener('DOMContentLoaded', function() {
    // TABS de colores
    const sliderButtons = document.querySelectorAll('.slider_button');
    sliderButtons.forEach(button => {
      button.addEventListener('click', function() {
        const id = this.getAttribute('id');
        
        // Remover clase activa de todos los botones
        sliderButtons.forEach(btn => btn.classList.remove('slider_button_active'));
        // Agregar clase activa al botón clickeado
        this.classList.add('slider_button_active');
        
        // Ocultar todos los sliders
        document.querySelectorAll('.slide_big_new').forEach(slide => {
          slide.style.display = 'none';
        });
        
        // Mostrar el slider correspondiente
        const sliderToShow = document.getElementById('slider-' + id);
        if (sliderToShow) {
          sliderToShow.style.display = 'block';
        }
      });
    });
  });
</script>

<style>
  /* Estilos específicos del C7 que se mantienen */
  .stats__title {
    font-size: 58px;
  }

  .model__tech .title-text {
    background-color: #f4f5f5;
  }

  .character-slider__content {
    top: 160px;
  }

  .character-slider__pagination {
    bottom: 60px;
  }

  .jc_cambio_color_blan,
  .jc_cambio_color_blan3 {
    background-color: #fff !important;
  }

  .jc_more_padding {
    padding-top: 40px;
  }

  .jc_txt1_cambio {
    color: #30363a !important;
    font-weight: 400 !important;
  }

  .jc_txt2_cambio {
    padding-top: 20px !important;
    color: #33393d !important;
    font-weight: 500 !important;
  }

  .jc_cambio_color_blan4,
  .jc_cambio_color_blan5,
  .jc_txt_blan6 {
    color: #fff !important;
  }

  .character-slider__pagination2 {
    color: #fff !important;
    height: 2px;
  }

  .jc_cambio_col_dark {
    background-color: #31363a !important;
  }

  .jc_tab_numbers {
    display: flex;
    justify-content: center;
    padding-bottom: 0px;
    flex-wrap: wrap;
  }

  .jc_cta_tab {
    font-size: 18px;
    line-height: 50px;
    color: #6f8590;
    font-weight: 500;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 10px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    background-color: transparent;
    transition: .2s;
  }

  .tab_activo_jc {
    text-transform: uppercase;
    color: #30363a;
    text-decoration: underline;
  }

  .slider_button_active {
    color: #30363a;
    text-decoration: underline;
  }

  .full-bg__img img {
    object-fit: contain !important;
  }

  .btn1_jc {
    display: inline-block;
    font-size: 14px;
    line-height: 27px;
    color: #30363a;
    font-weight: 500;
    font-family: "Avenir";
    text-align: center;
    border: 1px solid #30363a;
    padding: 15px 30px 15px 30px;
    margin-top: 20px;
    text-decoration: none;
  }

  .container {
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 15px;
    padding-right: 15px;
  }

  .datos_banner {
    right: auto;
    left: 120px;
    align-items: start;
    bottom: 69px;
  }

  .logo_banner {
    width: 150px;
  }

  .dos_columnas_banner {
    display: flex;
    align-items: center;
  }

  .txt_combustible {
    font-size: 22px;
    line-height: 25px;
    letter-spacing: 1px;
    font-weight: bold;
    font-family: Avenir, sans-serif;
  }

  .btn_next,
  .btn_prev {
    position: absolute;
    top: 50%;
    z-index: 1;
    transform: translateY(-50%);
    -webkit-transform: translateY(-50%);
    -moz-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    -o-transform: translateY(-50%);
    cursor: pointer;
  }

  .btn_next {
    right: 10px;
  }

  .btn_prev {
    left: 10px;
  }

  .tabs_news {
    border: 1px solid #000;
    width: 25px;
    height: 25px;
    border-radius: 1000px;
    background-color: #d0cbc8;
    margin-left: auto;
    margin-right: auto;
  }

  .stats__number-value {
    font-size: 56px !important;
  }

  .model__tech,
  .model__tech .title-text,
  .model__features,
  .model__features--white .title-text,
  .model__features .feature-block,
  .brand-page .content,
  .brand-page {
    background-color: #f4f5f5;
  }

  @media (max-width: 1199px) {
    .character-slider__content {
      top: 0px !important;
    }
    .character-slider__pagination {
      position: initial !important;
      bottom: 0px !important;
    }
  }

  @media (max-width: 767px) {
    .container {
      padding-left: 0;
      padding-right: 0;
    }
    .stats__number-value {
      font-size: 30px !important;
    }
  }

  @media (max-width: 579px) {
    .jc_cta_tab {
      padding: 0px 8px 0px 8px;
      font-size: 14px;
    }
  }

  @media (max-width: 479px) {
    .stats__number-value {
      font-size: 18px !important;
      text-decoration: none !important;
      color: #31373b !important;
    }
    .datos_banner {
      right: 16px;
      left: 16px;
      align-items: center;
      bottom: 69px;
    }
    .dos_columnas_banner {
      display: flex;
      align-items: start;
      margin-top: 5px;
    }
    .txt_combustible {
      font-size: 12px;
      line-height: 20px;
      font-weight: 400;
    }
  }
</style>